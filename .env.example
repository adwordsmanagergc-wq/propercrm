# ---------------------------------------------------------------------------
# Proper CRM environment variables
# Copy to `.env.local` and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe for the browser — RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY. Never expose to the browser.
# Used for sending invite emails and the scheduled schedule top-up.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app (used in auth redirects + invite links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled /api/cron/topup endpoint.
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional — customer emails (Resend). Without these, emails are logged as
# "not sent" in each customer's message history instead of going out.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# A verified sending address, e.g. notifications@propercrm.co.uk. The company
# name is used as the display name and its email as reply-to.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Optional — customer texts (Twilio).
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A UK number (+447…) or a Messaging Service SID (MG…).
TWILIO_FROM=
# true to let each company text as its own name (Settings → Text sender name).
TWILIO_ALLOW_ALPHA_SENDER=false

# ---------------------------------------------------------------------------
# Optional — card payments (Stripe Connect). Each company connects its own
# Stripe account from Settings; this is the platform's key.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Signing secret of a *Connect* webhook pointed at /api/stripe/webhook,
# listening for checkout.session.completed,
# checkout.session.async_payment_succeeded and account.updated.
STRIPE_WEBHOOK_SECRET=
# Optional platform fee on each card payment, in percent (e.g. 1). 0 = none.
STRIPE_APPLICATION_FEE_PERCENT=0

# ---------------------------------------------------------------------------
# Optional — integration tests only (npm run test). Tests skip if unset.
# Point these at a throwaway/local Supabase instance, never production.
# ---------------------------------------------------------------------------
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
