# ---------------------------------------------------------------------------
# Proper CRM environment variables
# Copy to `.env.local` and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe for the browser — RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY. Never expose to the browser.
# Used for sending invite emails and the scheduled schedule top-up.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed app (used in auth redirects + invite links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled /api/cron/topup endpoint.
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional — integration tests only (npm run test). Tests skip if unset.
# Point these at a throwaway/local Supabase instance, never production.
# ---------------------------------------------------------------------------
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
